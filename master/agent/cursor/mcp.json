{
  "mcpServers": {
    "zotero": {
      "type": "stdio",
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "exec \"$HOME/.local/bin/mcp-launcher\" \"$@\"",
        "mcp-launcher",
        "--env-file",
        "~/.secret",
        "--env",
        "ZOTERO_APP_PATH=/Applications/Zotero.app",
        "--env",
        "ZOTERO_AUTO_LAUNCH=true",
        "--env",
        "ZOTERO_EMBEDDING_MODEL=default",
        "--env",
        "ZOTERO_LIBRARY_ID=14669519",
        "--env",
        "ZOTERO_LOCAL=true",
        "--env",
        "ZOTERO_LOCAL_HOST=127.0.0.1",
        "--env",
        "ZOTERO_LOCAL_PORT=23119",
        "--env",
        "ZOTERO_MCP_ARGS=serve",
        "--env",
        "ZOTERO_MCP_BIN=~/.local/bin/zotero-mcp",
        "--env",
        "ZOTERO_READY_STABLE_POLLS=1",
        "--env",
        "ZOTERO_STARTUP_TIMEOUT_SEC=30",
        "--env",
        "ZOTERO_ADD_LOCAL_FILE_TIMEOUT_SEC=180",
        "--",
        "~/.local/bin/zotero-mcp-wrapper"
      ]
    },
    "xcode-tools": {
      "command": "xcrun",
      "args": [
        "mcpbridge"
      ]
    }
  }
}
