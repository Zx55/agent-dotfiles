{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/Documents/codex-workspace/agent-dotfiles/shared/hooks/codex-sync-config.py\" --config \"$HOME/.codex/config.toml\" --output \"$HOME/Documents/codex-workspace/agent-dotfiles/master/agent/codex/config.toml\" --hook-output",
            "statusMessage": "Syncing portable Codex config",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/Documents/codex-workspace/agent-dotfiles/shared/hooks/codex-sync-automations.py\" --runtime-dir \"$HOME/.codex/automations\" --output-dir \"$HOME/Documents/codex-workspace/agent-dotfiles/master/agent/codex/automations\" --hook-output",
            "statusMessage": "Syncing portable Codex automations",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/Documents/codex-workspace/agent-dotfiles/shared/hooks/codex-sync-config.py\" --config \"$HOME/.codex/config.toml\" --output \"$HOME/Documents/codex-workspace/agent-dotfiles/master/agent/codex/config.toml\" --hook-output",
            "statusMessage": "Syncing portable Codex config",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/Documents/codex-workspace/agent-dotfiles/shared/hooks/codex-sync-automations.py\" --runtime-dir \"$HOME/.codex/automations\" --output-dir \"$HOME/Documents/codex-workspace/agent-dotfiles/master/agent/codex/automations\" --hook-output",
            "statusMessage": "Syncing portable Codex automations",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/Documents/codex-workspace/agent-dotfiles/shared/hooks/codex-sync-config.py\" --config \"$HOME/.codex/config.toml\" --output \"$HOME/Documents/codex-workspace/agent-dotfiles/master/agent/codex/config.toml\" --hook-output",
            "statusMessage": "Syncing portable Codex config",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$HOME/Documents/codex-workspace/agent-dotfiles/shared/hooks/codex-sync-automations.py\" --runtime-dir \"$HOME/.codex/automations\" --output-dir \"$HOME/Documents/codex-workspace/agent-dotfiles/master/agent/codex/automations\" --hook-output",
            "statusMessage": "Syncing portable Codex automations",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
