{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/agent-dotfiles/python/bin/python\" \"$HOME/Documents/agent-dotfiles/master/agent/codex/hooks/codex-sync-config.py\" --config \"$HOME/.codex/config.toml\" --output \"$HOME/Documents/agent-dotfiles/master/agent/codex/config.toml\" --hook-output",
            "statusMessage": "Syncing portable Codex config",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/agent-dotfiles/python/bin/python\" \"$HOME/Documents/agent-dotfiles/master/agent/codex/hooks/codex-sync-automations.py\" --runtime-dir \"$HOME/.codex/automations\" --output-dir \"$HOME/Documents/agent-dotfiles/master/agent/codex/automations\" --hook-output",
            "statusMessage": "Syncing portable Codex automations",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/agent-dotfiles/python/bin/python\" \"$HOME/Documents/agent-dotfiles/master/agent/codex/hooks/codex-sync-config.py\" --config \"$HOME/.codex/config.toml\" --output \"$HOME/Documents/agent-dotfiles/master/agent/codex/config.toml\" --hook-output",
            "statusMessage": "Syncing portable Codex config",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/agent-dotfiles/python/bin/python\" \"$HOME/Documents/agent-dotfiles/master/agent/codex/hooks/codex-sync-automations.py\" --runtime-dir \"$HOME/.codex/automations\" --output-dir \"$HOME/Documents/agent-dotfiles/master/agent/codex/automations\" --hook-output",
            "statusMessage": "Syncing portable Codex automations",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/agent-dotfiles/python/bin/python\" \"$HOME/Documents/agent-dotfiles/master/agent/codex/hooks/codex-secret-guard-tool-use-after.py\" --hook-output",
            "statusMessage": "Auditing Bash output for sensitive values",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/share/agent-dotfiles/python/bin/python\" \"$HOME/Documents/agent-dotfiles/master/agent/codex/hooks/codex-sync-config.py\" --config \"$HOME/.codex/config.toml\" --output \"$HOME/Documents/agent-dotfiles/master/agent/codex/config.toml\" --hook-output",
            "statusMessage": "Syncing portable Codex config",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME/.local/share/agent-dotfiles/python/bin/python\" \"$HOME/Documents/agent-dotfiles/master/agent/codex/hooks/codex-sync-automations.py\" --runtime-dir \"$HOME/.codex/automations\" --output-dir \"$HOME/Documents/agent-dotfiles/master/agent/codex/automations\" --hook-output",
            "statusMessage": "Syncing portable Codex automations",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
