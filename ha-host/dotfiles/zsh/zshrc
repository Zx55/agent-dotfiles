# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="ys"

plugins=(git zsh-syntax-highlighting copyfile copypath)

source "$ZSH/oh-my-zsh.sh"

# Homebrew's regular node formula is linked through /opt/homebrew/bin by
# brew shellenv in zprofile. Do not prepend versioned node paths here.
[[ -d /usr/local/texlive/2026/bin/universal-darwin ]] && export PATH="/usr/local/texlive/2026/bin/universal-darwin:$PATH"

export UV_PYTHON=3.11
export UV_MANAGED_PYTHON=1
command -v uv >/dev/null 2>&1 && eval "$(uv generate-shell-completion zsh)"

if [[ -f "$HOME/.secret" ]]; then
  source "$HOME/.secret"
fi

alias proxy_on="export https_proxy=http://127.0.0.1:7897; export http_proxy=http://127.0.0.1:7897; export HTTP_PROXY=http://127.0.0.1:7897; export HTTPS_PROXY=http://127.0.0.1:7897; export all_proxy=socks5://127.0.0.1:7897"
alias proxy_off="unset http_proxy; unset https_proxy; unset HTTP_PROXY; unset HTTPS_PROXY; unset all_proxy; unset ALL_PROXY"
alias cat="bat"
alias hf-cli="huggingface-cli"

[[ -f "$HOME/Documents/scripts/hfd.sh" ]] && alias hfd="$HOME/Documents/scripts/hfd.sh"
[[ -f "$HOME/Documents/scripts/combine.py" ]] && alias combine="python $HOME/Documents/scripts/combine.py"

[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"